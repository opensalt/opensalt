{% extends 'layout.html.twig' %}

{% block javascripts %}
    {{ importmap('credential', { nonce: csp_nonce('script') }) }}
{% endblock %}

{% block styles %}
    <link rel="stylesheet" href="{{ asset('sass/credential.scss') }}">
    <style>
        .fade {
            opacity: 100;
        }
        .tab-pane.show {
        }
    </style>
{% endblock %}

{% block bodyclasses %}ob3-definer{% endblock %}
{% block body %}
    <div class="float-end">
        <ul class="list-inline text-right">
            <li>
                <a class="btn btn-default" href="{{ path('credential_index') }}">Cancel</a>
            </li>
        </ul>
    </div>
    <div class="clearfix"></div>

    {{ form_start(form, {'attr': {'id': 'credential_definition_form'}}) }}
        <div class="container">
            {{ form_widget(form) }}
        </div>

        <div id="ob3-definer" data-achievement='{{ def }}'></div>
        {# The ob3-open/saveDefinition wiring lives in assets/js/credential.js. #}
    {{ form_end(form) }}

{% endblock %}

{% block title %}
    Create a new credential
{% endblock %}
