{% extends 'layout.html.twig' %}

{% block body %}
    {% if not app.request.xmlHttpRequest %}
        <h1>Change LsItem Parent</h1>
    {% endif %}

    {{ form_start(form) }}
    {{ form_widget(form) }}

    <div id="lsItemListWrap-changeParent" class="row">
        <div class="col-sm-12">
            <section id="lsItemList" class="card card-default card-component">
                {% if lsDoc is not empty %}
                    <div class="card-header">Select Destination Standard:</div>
                    <div class="card-body">
                        <div>
                            {{ render_esi(path('editor_render', {'id':lsDoc.id})) }}
                        </div>
                    </div>
                {% endif %}
            </section>
        </div>
    </div>

    {% if not app.request.xmlHttpRequest %}
        <input class="btn btn-primary" type="submit" value="Change" />
    {% endif %}
    {{ form_end(form) }}

    {% if not app.request.xmlHttpRequest %}
        <br/>
        <ul class="list-inline">
            <li class="list-inline-item">
                <a class="btn btn-default" href="{{ path('lsassociation_index') }}">Back to the list</a>
            </li>
        </ul>
    {% endif %}
{% endblock %}


{% block javascripts %}
    <script>
        (function () {
            const itemListWrap = document.getElementById('lsItemListWrap-changeParent');
            const parentField = document.getElementById('ls_item_parent_parentItem');
            if (!itemListWrap || !parentField) {
                return;
            }

            itemListWrap.addEventListener('click', (e) => {
                e.stopPropagation();
                e.preventDefault();

                if (e.target.closest('.lsDoc')) {
                    parentField.value = '';
                    return;
                }

                const itemLink = e.target.closest('.lsItem');
                if (itemLink) {
                    parentField.value = (itemLink.getAttribute('name') ?? '').replace('mark-', '');
                }
            });
        })();
    </script>
{% endblock %}
