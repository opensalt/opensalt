{% extends 'base.html.twig' %}

{% block title %}OpenSALT Framework Editor{% endblock %}

{% block bodyclasses %}editor-shell-page{% endblock %}

{% block styles %}
    {{ parent() }}
    <style>
        .editor-shell-page .container.container--main {
            height: 100vh;
            max-width: 100%;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            padding-bottom: 0;
            padding-left: 0;
            padding-right: 0;
        }

        .editor-shell-page .header {
            flex-shrink: 0;
            margin-bottom: 0 !important;
        }

        .editor-shell-page main.content.editor-shell-main {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 0;
            margin-bottom: 0 !important;
            overflow: hidden;
            padding-left: 0;
            padding-right: 0;
        }

        .editor-shell-page main.content.editor-shell-main #app {
            flex: 1;
            height: 100%;
            min-height: 0;
        }

        .editor-shell-page .footer {
            position: static;
            flex-shrink: 0;
        }

    </style>
    {% if not editorDevMode %}
        {% for styleUrl in editorProdStyles %}
            <link rel="stylesheet" href="{{ styleUrl|e('html_attr') }}">
        {% endfor %}
    {% endif %}
{% endblock %}

{% block mainclasses %}editor-shell-main{% endblock %}

{% block body %}
    <div id="app"></div>
    <script>
        window.openSaltEditor = Object.assign({}, window.openSaltEditor || {}, {
            features: {{ editorFeatures|default({})|json_encode(constant('JSON_THROW_ON_ERROR'))|raw }},
        });
    </script>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if editorDevMode %}
        <script type="module" src="{{ editorDevClient|e('html_attr') }}"></script>
        <script type="module" src="{{ editorDevEntry|e('html_attr') }}"></script>
    {% else %}
        {% for scriptUrl in editorProdScripts %}
            <script type="module" src="{{ scriptUrl|e('html_attr') }}"></script>
        {% endfor %}
    {% endif %}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (!window.bootstrap || !window.bootstrap.Dropdown) {
                return;
            }
            document.querySelectorAll('header [data-bs-toggle="dropdown"]').forEach(function (el) {
                window.bootstrap.Dropdown.getOrCreateInstance(el);
            });
        });
    </script>
{% endblock %}
